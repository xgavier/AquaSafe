PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Backend Node usando ODBC + Shared Memory, igual que el servicio de IA en Python.
# Esto evita TCP/IP en SQL Server.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=lpc:GT-NU-WEB-MD\MSSQL_25
DB_USER=sa
DB_PASSWORD=change_me
DB_DATABASE=AquaSafeDB
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true
DB_TRUSTED_CONNECTION=false

# Alternativa: puedes usar una cadena completa y se ignoraran las variables de arriba.
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=lpc:GT-NU-WEB-MD\MSSQL_25;Database=AquaSafeDB;UID=sa;PWD=change_me;Encrypt=no;TrustServerCertificate=yes;

AI_SERVICE_URL=http://127.0.0.1:8000
