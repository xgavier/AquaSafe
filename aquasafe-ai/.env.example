# Clave de API de Google Gemini (Opcional, si no se provee se usa heurística local)
GEMINI_API_KEY=

# Configuración del puerto serial del Arduino
SERIAL_PORT=COM3
SERIAL_BAUDRATE=9600
TELEMETRY_INTERVAL=2

# Código del tinaco al que se asocian las lecturas de este Arduino
TANK_CODE=AQS-00001

# Simular puerto serial (true/false) - Útil para probar sin Arduino físico conectado
MOCK_SERIAL=true

# URL del backend para reportar telemetría
BACKEND_URL=http://localhost:4000/api/telemetry

# Configuración de base de datos SQL Server (para el servicio de IA)
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=change_me
DB_DATABASE=AquaSafeDB
